# ─────────────────────────────────────────────────────────────────────────────
# AI Governance Frontend — Environment Configuration (template)
# Copy to `.env` and adjust. Vite exposes only VITE_* vars to the client.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Backend BFF (not the LiteLLM gateway directly).
VITE_API_BASE_URL=http://localhost:8080

# Backend endpoint paths.
VITE_CHAT_PATH=/api/chat
VITE_HEALTH_PATH=/health

# Model catalog offered in the UI (comma-separated).
VITE_DEFAULT_MODEL=gemini-flash
VITE_MODELS=gemini-flash,gpt-3.5-turbo,gemini-pro,gpt-4o-mini,gpt-4o

# Default generation params + client request timeout (ms).
VITE_DEFAULT_TEMPERATURE=0.7
VITE_REQUEST_TIMEOUT_MS=60000
