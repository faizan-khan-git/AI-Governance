FROM ghcr.io/berriai/litellm@sha256:de5b050c1e9bd7e6c0aebfa126c5df71de071962592ba3e9638b28e45bed3901

# Install psycopg for async PostgreSQL audit logging
RUN pip install --no-cache-dir "psycopg[binary]"

WORKDIR /app
ENV PYTHONPATH="/app:${PYTHONPATH}"

COPY callbacks /app/callbacks
COPY proxy_config.yaml /app/config/proxy_config.yaml

EXPOSE 4000
ENTRYPOINT ["litellm", "--config", "/app/config/proxy_config.yaml", "--port", "4000"]
