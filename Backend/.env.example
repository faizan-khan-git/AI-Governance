# ─────────────────────────────────────────────────────────────────────────────
# AI Governance Backend — Environment Configuration
# Copy this file to `.env` and fill in the real values.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP server
PORT=8080
NODE_ENV=development
# Interface to bind. Loopback by default; use 0.0.0.0 only inside a container/cluster.
HOST=127.0.0.1
# Number of reverse proxies in front of this app (e.g. 1 behind one ingress). Leave unset
# when clients connect directly: X-Forwarded-For is then ignored, so a client cannot spoof
# its IP address to bypass the per-IP rate limit. "true" is rejected.
# TRUST_PROXY=1

# ── LiteLLM Gateway ──────────────────────────────────────────────────────────
# Inside the Kubernetes cluster use the internal ClusterIP service:
#   http://litellm-internal.litellm.svc.cluster.local:4000
# For local development against the NodePort, use:
#   http://localhost:30080
LITELLM_BASE_URL=http://litellm-internal.litellm.svc.cluster.local:4000

# ── (Deprecated) Single Proxy Token ─────────────────────────────────────────
# No longer used — the gateway key is always chosen from the caller's role.
# LITELLM_PROXY_TOKEN=

# ── Default model + generation params ────────────────────────────────────────
# Model used when the client does not specify one. Must be allowed by the
# virtual key above (see RBAC roles in the project README).
DEFAULT_MODEL=gemini-flash
DEFAULT_TEMPERATURE=0.7

# Upstream request timeout in milliseconds
REQUEST_TIMEOUT_MS=60000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed front-end origins. When unset it defaults to the Vite
# dev server (http://localhost:5173 and http://127.0.0.1:5173) — never "*". A wildcard
# must be set explicitly, and is rejected when NODE_ENV=production.
# If Vite starts on another port, add that origin here.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ── Request limits ───────────────────────────────────────────────────────────
# Defaults shown. The chat validator rejects anything larger with HTTP 413.
# MAX_TEXT_LENGTH=32000        # characters in one message
# MAX_SYSTEM_LENGTH=8000       # characters in the optional system prompt
# MAX_HISTORY_MESSAGES=40      # prior turns accepted in "history"
# MAX_HISTORY_CHARS=64000      # total characters across "history"

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ── RBAC: per-request role → LiteLLM virtual key ─────────────────────────────
# The Backend authenticates each caller, resolves their role, and forwards the
# request with the LiteLLM virtual key for that role. The gateway then enforces
# the role's model allowlist, rate limits, and budget.
#
# RBAC is always enforced: every /api/chat call needs a valid JWT or API key.
# Role tokens are auto-loaded from ../tokens/.env.tokens when that file exists.

# Backend's OWN secret for verifying caller JWTs (HS256). Independent from the
# LiteLLM gateway. REQUIRED: generate one with `openssl rand -hex 32` (>= 32 chars).
# Documentation placeholders are rejected at startup. Remove this line entirely to
# fall back to LITELLM_JWT_SECRET. Tokens must carry an `exp` claim.
AUTH_JWT_SECRET=

# Optional: key for the pseudonymous end-user ids sent to the gateway (HMAC of the JWT
# `sub`). Defaults to AUTH_JWT_SECRET. Map an id back to a person with
#   node scripts/end-user-id.mjs --sub alice@example.com
# AUTH_END_USER_KEY=

# Optional: the AI Registry system (name or id) this Backend represents. Usage is then
# attributed to that system; without it a request is only attributed when its team has
# exactly one registered system. It must belong to the caller's team.
# AI_SYSTEM=Customer Support Bot

# Per-role LiteLLM virtual keys. Easiest: run the Backend after sourcing the
# project tokens (exports these three vars):
#     source ../tokens/.env.tokens && npm start
# Or set them explicitly here:
# LITELLM_DEV_TOKEN=sk-...
# LITELLM_STANDARD_TOKEN=sk-...
# LITELLM_ADMIN_TOKEN=sk-...

# Optional: static API-key → role map (JSON) as an alternative to JWT, for
# service-to-service callers sending the X-API-Key header. Use long random keys
# (`openssl rand -hex 32`). Short keys and the keys shown in the docs are flagged at
# startup, and rejected when NODE_ENV=production. Shape:
#   RBAC_API_KEYS={"<random-64-hex>":"dev","<another-random-64-hex>":"admin"}
# RBAC_API_KEYS=

# ── Database Connection ──────────────────────────────────────────────────────
# PostgreSQL connection string for AI Registry audit querying and quota management.
# DATABASE_URL=postgresql://litellm:password@localhost:5432/litellm
