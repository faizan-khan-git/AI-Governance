# ─────────────────────────────────────────────────────────────────────────────
# AI Governance Backend — Environment Configuration
# Copy this file to `.env` and fill in the real values.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP server
PORT=8080
NODE_ENV=development

# ── LiteLLM Gateway ──────────────────────────────────────────────────────────
# Inside the Kubernetes cluster use the internal ClusterIP service:
#   http://litellm-internal.litellm.svc.cluster.local:4000
# For local development against the NodePort, use:
#   http://localhost:30080
LITELLM_BASE_URL=http://litellm-internal.litellm.svc.cluster.local:4000

# ── Internal JWT / Proxy Token ───────────────────────────────────────────────
# The LiteLLM virtual key (Bearer token) this backend uses to authenticate to
# the gateway. Injected into the Authorization header on every forwarded call.
# NEVER commit the real value. Source it from tokens/.env.tokens, e.g.
#   $LITELLM_DEV_TOKEN / $LITELLM_STANDARD_TOKEN / $LITELLM_ADMIN_TOKEN
LITELLM_PROXY_TOKEN=sk-replace-with-your-virtual-key

# ── Default model + generation params ────────────────────────────────────────
# Model used when the client does not specify one. Must be allowed by the
# virtual key above (see RBAC roles in the project README).
DEFAULT_MODEL=gemini-flash
DEFAULT_TEMPERATURE=0.7

# Upstream request timeout in milliseconds
REQUEST_TIMEOUT_MS=60000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * to allow all (dev only).
CORS_ORIGIN=*

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
