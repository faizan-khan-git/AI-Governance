{
  "name": "ai-governance-backend",
  "version": "1.0.0",
  "description": "Express.js BFF that formats raw text into OpenAI-compatible payloads, injects the internal LiteLLM proxy token, and returns sanitized model responses.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "keywords": [
    "litellm",
    "ai-gateway",
    "express",
    "openai",
    "bff"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  }
}
